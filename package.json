{
  "name": "qr-reader",
  "version": "1.0.1",
  "description": "Right-click an image to read its QR code and open the decoded URL in a new tab.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "npm run generate-icons && wxt build",
    "zip": "npm run generate-icons && wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate-icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  }
}
